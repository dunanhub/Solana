{
  "name": "liquidity-vault",
  "version": "0.1.0",
  "private": true,
  "description": "Liquidity Vault: deposits and shares — Бекзат Убниев",
  "engines": {
    "node": ">=20.18.0"
  },
  "scripts": {
    "test:integration": "ts-mocha -p ./tsconfig.json -t 120000 \"tests/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "devnet:deposit": "ts-node scripts/devnet-deposit.ts",
    "devnet:withdraw": "ts-node scripts/devnet-withdraw.ts",
    "raydium": "ts-node scripts/raydium/cli.ts",
    "test:raydium": "ts-mocha -p ./tsconfig.json scripts/raydium/policy.test.ts",
    "strategy:fixtures": "ts-node scripts/strategy/prepare-fixtures.ts",
    "strategy": "ts-node scripts/strategy/devnet.ts",
    "strategy:verify-upgrade": "ts-node scripts/strategy/verify-upgrade.ts",
    "test:strategy-policy": "ts-mocha -p ./tsconfig.json scripts/strategy/policy.test.ts",
    "liquidity": "ts-node scripts/liquidity/devnet.ts",
    "test:liquidity-policy": "ts-mocha -p ./tsconfig.json scripts/liquidity/policy.test.ts"
  },
  "dependencies": {
    "@coral-xyz/anchor": "0.31.1",
    "@raydium-io/raydium-sdk-v2": "0.2.74-alpha",
    "@solana/spl-token": "0.4.14",
    "@solana/web3.js": "1.98.4",
    "bn.js": "5.2.2",
    "decimal.js": "10.6.0"
  },
  "resolutions": {
    "@solana/web3.js": "1.98.4",
    "rpc-websockets": "9.1.3"
  },
  "devDependencies": {
    "@types/bn.js": "5.2.0",
    "@types/chai": "4.3.20",
    "@types/mocha": "10.0.10",
    "@types/node": "22.15.30",
    "chai": "4.5.0",
    "mocha": "10.8.2",
    "ts-mocha": "10.1.0",
    "ts-node": "10.9.2",
    "typescript": "5.7.3"
  }
}
